# ============================================================================
# AI Interview Assistance & Survey Instrument System — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# --- Database -----------------------------------------------------------------
# PRODUCTION (PostgreSQL — recommended architecture):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ai_interview_system?schema=public"
# LOCAL ZERO-CONFIG DEV (SQLite mirror schema, run `npm run setup:local`):
# DATABASE_URL="file:./dev.db"

# --- Authentication -----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-secret"
# Admin session lifetime in hours
SESSION_TTL_HOURS="12"
# Force the session cookie's Secure flag (true|false). Leave unset to derive it from
# NEXT_PUBLIC_APP_URL: https origins get a Secure cookie, plain-HTTP LAN origins do not
# (browsers DROP Secure cookies on http, which made admin sign-in appear to fail).
AUTH_COOKIE_SECURE=""

# --- App ----------------------------------------------------------------------
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME: changing NEXT_PUBLIC_APP_URL in the
# hosting dashboard after a deploy has no effect until the app is rebuilt. For QR codes /
# respondent links, prefer APP_URL (read at runtime) — on Render, RENDER_EXTERNAL_URL is
# used automatically, so no configuration is required at all.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Runtime override for the public base URL (e.g. "https://system-ulit-1.onrender.com").
APP_URL=""

# --- Startup (hosting only) ----------------------------------------------------
# Database bootstrap during service start (npm `prestart` hook):
#   background (default) — Next.js binds its port immediately, schema push + seed run in
#                          parallel (no more "No open ports detected" warnings)
#   block                — finish the bootstrap before Next.js starts (slow cold starts)
#   off                  — skip it entirely (the build command already runs db:ensure-pg)
# Ignored for local SQLite development (DATABASE_URL=file:...).
DB_ENSURE_ON_START="background"

# --- AI (server-side only — NEVER exposed to the browser) ----------------------
# Leave OPENAI_API_KEY empty to use the built-in deterministic offline AI engine.
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
# auto | openai | offline
AI_PROVIDER="auto"

# --- Seed ---------------------------------------------------------------------
# Default administrator created by `npm run seed` (password is hashed, never stored in plain text)
SEED_ADMIN_USERNAME="Admin"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL="admin@aiis.local"
# Set to "true" only in development to also seed sample surveys/responses
SEED_SAMPLE_DATA="true"
# Set to "true" to reset the password of an EXISTING admin to SEED_ADMIN_PASSWORD while
# seeding. Left disabled on purpose: the seed also runs on every hosting start, so an
# unconditional reset silently reverted a changed live password to the default after each
# deploy. Use `npm run admin:reset` when you really want to reset it.
SEED_RESET_ADMIN_PASSWORD="false"