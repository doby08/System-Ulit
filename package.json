{
  "name": "ai-interview-survey-system",
  "version": "2026.1.0",
  "private": true,
  "description": "Centralized AI-powered Interview Assistance & Survey Instrument System (Admin + QR Respondent PWA)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prisma-generate.mjs",
    "setup:local": "node scripts/make-sqlite-schema.mjs && prisma generate --schema prisma/schema.sqlite.prisma && prisma db push --schema prisma/schema.sqlite.prisma --skip-generate && npm run seed",
    "setup:pg": "prisma generate && prisma db push --skip-generate && npm run seed",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:ensure-pg": "node scripts/db-ensure-pg.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "render-build": "npm run db:ensure-pg && next build",
    "prestart": "node scripts/prestart.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "docx": "^9.0.3",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.0.0",
    "idb": "^8.0.0",
    "jose": "^5.9.6",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3"
  }
}
